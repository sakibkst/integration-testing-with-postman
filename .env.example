# Copy to .env and adjust. Loaded by scripts/run-newman.js and passed to Newman
# as environment-variable overrides on top of postman/DMoney-Local.postman_environment.json.

# DMoney API (see dmoney-transaction-api)
BASE_URL=http://localhost:5000

# Must equal the API's PARTNER_KEY (sent as X-AUTH-SECRET-KEY)
PARTNER_KEY=ROADTOSDET

# Dev-only OTP bypass: must equal the API's DEFAULT_OTP
DEFAULT_OTP=0000

# Seeded accounts used by the flow
ADMIN_EMAIL=admin@dmoney.com
ADMIN_PASSWORD=1234
SYSTEM_EMAIL=system@dmoney.com
SYSTEM_PASSWORD=1234

# Password given to the users the collection registers
USER_PASSWORD=1234
